# Database (local dev)
DB_URL=jdbc:postgresql://localhost:5432/salalilas_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres

$ Database ( Docker / prod)
DB_URL=jdbc:postgresql://localhost:5432/salalilas
DB_USERNAME=salalilas
DB_PASSWORD=salalilas
DB_NAME=salalilas
DB_USER=salalilas

# Flyway
FLYWAY_MIGRATION_PATH=../database/migration

# JWT
JWT_SECRET=dev-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_CALLBACK_URL=http://localhost:3000/oauth2/callback

# PDF
PDF_STORAGE_PATH=/tmp/salalilas/pdfs

# OAuth2
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
MICROSOFT_CLIENT_ID=dummy
MICROSOFT_CLIENT_SECRET=dummy